// DapurHPP - Prisma Schema
// Stack: NestJS + Prisma + MySQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
   url     = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// MASTER DATA
// ─────────────────────────────────────────

model User {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  name       String   @db.VarChar(100)
  email      String   @unique @db.VarChar(150)
  password   String   @db.VarChar(255) // bcrypt
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  bahanBaku       BahanBaku[]
  supplier        Supplier[]
  resep           Resep[]
  belanja         Belanja[]
  produksi        Produksi[]
  penjualan       Penjualan[]
  pengeluaranLain PengeluaranLain[]

  @@map("users")
}

model BahanBaku {
  id            Int             @id @default(autoincrement()) @db.UnsignedInt
  userId        Int             @db.UnsignedInt @map("user_id")
  nama          String          @db.VarChar(100)
  satuan        Satuan
  kategori      KategoriBahan   @default(LAINNYA)
  fotoUrl       String?         @db.VarChar(255) @map("foto_url")  // ← TAMBAH INI
  hargaTerakhir Decimal         @default(0) @db.Decimal(12, 2) @map("harga_terakhir")
  stok          Decimal         @default(0) @db.Decimal(10, 3) @map("stok")
  stokMinimal   Decimal         @default(0) @db.Decimal(10, 3) @map("stok_minimal")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")

  user          User            @relation(fields: [userId], references: [id])
  detailResep   DetailResep[]
  detailBelanja DetailBelanja[]

  @@unique([userId, nama])
  @@index([userId])
  @@index([nama])
  @@map("bahan_baku")
}

model Supplier {
  id        Int       @id @default(autoincrement()) @db.UnsignedInt
  userId    Int       @db.UnsignedInt @map("user_id")
  nama      String    @db.VarChar(100)
  alamat    String?   @db.VarChar(200)
  telepon   String?   @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // soft delete

  user          User            @relation(fields: [userId], references: [id])
  detailBelanja DetailBelanja[]

  @@index([userId])
  @@map("supplier")
}

model Resep {
  id             Int       @id @default(autoincrement()) @db.UnsignedInt
  userId         Int       @db.UnsignedInt @map("user_id")
  nama           String    @db.VarChar(100)
  fotoUrl        String?   @db.VarChar(255) @map("foto_url")
  estimasiHasil  Int       @db.UnsignedInt @map("estimasi_hasil")
  hargaJual      Decimal   @default(0) @db.Decimal(12, 2) @map("harga_jual")
  catatan        String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  user        User          @relation(fields: [userId], references: [id])
  detailResep DetailResep[]
  produksi    Produksi[]

  @@index([userId])
  @@map("resep")
}

model DetailResep {
  id          Int     @id @default(autoincrement()) @db.UnsignedInt
  resepId     Int     @db.UnsignedInt @map("resep_id")
  bahanBakuId Int     @db.UnsignedInt @map("bahan_baku_id")
  jumlah      Decimal @db.Decimal(10, 3)
  satuan      Satuan  // harus sama dengan satuan bahan_baku — konversi ditangani v2

  resep     Resep     @relation(fields: [resepId], references: [id])
  bahanBaku BahanBaku @relation(fields: [bahanBakuId], references: [id])

  @@unique([resepId, bahanBakuId])
  @@map("detail_resep")
}

// ─────────────────────────────────────────
// OPERASIONAL
// ─────────────────────────────────────────

model Belanja {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  userId       Int      @db.UnsignedInt @map("user_id")
  tanggal      DateTime @db.Date
  totalBelanja Decimal  @default(0) @db.Decimal(12, 2) @map("total_belanja") // auto-sum dari detail
  catatan      String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  detailBelanja DetailBelanja[]

  @@index([userId, tanggal])
  @@index([tanggal])
  @@map("belanja")
}

model DetailBelanja {
  id          Int     @id @default(autoincrement()) @db.UnsignedInt
  belanjaId   Int     @db.UnsignedInt @map("belanja_id")
  bahanBakuId Int     @db.UnsignedInt @map("bahan_baku_id")
  supplierId  Int?    @db.UnsignedInt @map("supplier_id") // nullable
  jumlah      Decimal @db.Decimal(10, 3)
  satuan      Satuan
  hargaSatuan Decimal @db.Decimal(12, 2) @map("harga_satuan") // sumber riwayat harga
  subtotal    Decimal @db.Decimal(12, 2) // jumlah × harga_satuan, dihitung di service

  belanja   Belanja   @relation(fields: [belanjaId], references: [id])
  bahanBaku BahanBaku @relation(fields: [bahanBakuId], references: [id])
  supplier  Supplier? @relation(fields: [supplierId], references: [id])

  @@index([bahanBakuId, belanjaId]) // untuk query riwayat harga per bahan
  @@map("detail_belanja")
}

model Produksi {
  id                    Int           @id @default(autoincrement()) @db.UnsignedInt
  userId                Int           @db.UnsignedInt @map("user_id")
  resepId               Int           @db.UnsignedInt @map("resep_id")
  tanggal               DateTime      @db.Date
  estimasiHasil         Int           @db.UnsignedInt @map("estimasi_hasil")
  hasilNyata            Int           @db.UnsignedInt @map("hasil_nyata")
  hppPerPcs             Decimal       @db.Decimal(12, 2) @map("hpp_per_pcs")     // snapshot saat produksi
  hargaJualSaatProduksi Decimal       @db.Decimal(12, 2) @map("harga_jual_saat_produksi") // snapshot
  totalModal            Decimal       @db.Decimal(12, 2) @map("total_modal")     // hpp_per_pcs × hasil_nyata
  status                StatusProduksi @default(DRAFT)
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id])
  resep     Resep      @relation(fields: [resepId], references: [id])
  penjualan Penjualan[]
  detailProduksi DetailProduksi[]

  @@index([userId, tanggal])
  @@index([resepId])
  @@map("produksi")
}

model DetailProduksi {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  produksiId    Int      @db.UnsignedInt @map("produksi_id")
  bahanBakuId   Int      @db.UnsignedInt @map("bahan_baku_id")
  nama          String   @db.VarChar(191)              // snapshot nama, jangan relasi live
  jumlah        Decimal  @db.Decimal(10, 2)
  satuan        Satuan
  hargaTerakhir Decimal  @db.Decimal(12, 2) @map("harga_terakhir") // snapshot harga saat itu
  total         Decimal  @db.Decimal(12, 2)             // jumlah × hargaTerakhir

  produksi Produksi @relation(fields: [produksiId], references: [id], onDelete: Cascade)

  @@index([produksiId])
  @@map("detail_produksi")
}

model Penjualan {
  id              Int           @id @default(autoincrement()) @db.UnsignedInt
  userId          Int           @db.UnsignedInt @map("user_id")
  produksiId      Int           @db.UnsignedInt @map("produksi_id")
  tanggal         DateTime      @db.Date
  terjual         Int           @db.UnsignedInt
  hargaJual       Decimal       @db.Decimal(12, 2) @map("harga_jual")
  totalPendapatan Decimal       @db.Decimal(12, 2) @map("total_pendapatan") // terjual × harga_jual
  sisa            Int           @db.UnsignedInt // hasil_nyata - terjual, dihitung di service
  status          StatusPenjualan @default(OPEN)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id])
  produksi Produksi @relation(fields: [produksiId], references: [id])

  @@index([userId, tanggal])
  @@map("penjualan")
}

model PengeluaranLain {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  userId    Int      @db.UnsignedInt @map("user_id")
  tanggal   DateTime @db.Date
  nama      String   @db.VarChar(100) // Gas, Plastik, Kemasan, dll
  jumlah    Decimal  @db.Decimal(12, 2)
  kategori  KategoriPengeluaran @default(LAINNYA)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, tanggal])
  @@map("pengeluaran_lain")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum Satuan {
  kg
  gram
  liter
  ml
  pcs
  buah
  bungkus
}

enum StatusProduksi {
  DRAFT
  SELESAI
  BATAL
}

enum StatusPenjualan {
  OPEN
  CLOSED
}

enum KategoriBahan {
  TEPUNG
  MINYAK
  SAYURAN
  BUMBU
  DAGING
  LAINNYA
}

enum KategoriPengeluaran {
  UTILITAS
  KEMASAN
  TRANSPORTASI
  KEBERSIHAN
  LAINNYA
}
